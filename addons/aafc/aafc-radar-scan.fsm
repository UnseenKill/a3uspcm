                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Delay">*/
                class Delay
                {
                        name = "Delay";
                        itemno = 8;
                        init = /*%FSM<STATEINIT""">*/"private _delay = diag_tickTime + _nextDelay;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "continue">*/
                                class continue
                                {
                                        itemno = 9;
                                        priority = 0.000000;
                                        to="Loop";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"diag_tickTime > _delay"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "POI_refresh">*/
                class POI_refresh
                {
                        name = "POI_refresh";
                        itemno = 14;
                        init = /*%FSM<STATEINIT""">*/"[""POI refresh""] call _TRACE;" \n
                         "" \n
                         "private _markers = (airportsX + milbases + [""NATO_Carrier"",""CSAT_Carrier""]) select {" \n
                         "    [""POI: %1=%2"", _x, markerType _x] call _TRACE;" \n
                         "    markerType _x isNotEqualTo """";" \n
                         "} select {" \n
                         "    sidesX getVariable[_x, sideUnknown] isNotEqualTo side _vehicle;" \n
                         "};" \n
                         "" \n
                         "[""markers=%1"", _markers] call _TRACE;" \n
                         "" \n
                         "_poiList = [_markers] call CBA_fnc_shuffle;" \n
                         "_poiScan = diag_tickTime + 180;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "_">*/
                                class _
                                {
                                        itemno = 11;
                                        priority = 0.000000;
                                        to="Reiterate";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "POI_pick">*/
                class POI_pick
                {
                        name = "POI_pick";
                        itemno = 16;
                        init = /*%FSM<STATEINIT""">*/"private _doSweep = !_canTarget || { (random 100) < 25 };" \n
                         "" \n
                         "if (_canSweep && {_doSweep || { _poiList isEqualTo [] }}) then {" \n
                         "    _poiCurrent = [diag_tickTime + _interestSweepTTL, false];" \n
                         "} else {" \n
                         "    _poiCurrent = [diag_tickTime + _interestPOITTL, _poiList deleteAt 0];" \n
                         "};" \n
                         "" \n
                         "[""new POI=%1 -------------------------------------------------"", _poiCurrent] call _TRACE;" \n
                         "_poiIteration = -1;" \n
                         "_nextDelay = 5;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "_">*/
