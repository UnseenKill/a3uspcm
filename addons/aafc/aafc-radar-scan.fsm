                /*%FSM<STATE "Initialize">*/
                class Initialize
                {
                        name = "Initialize";
                        itemno = 1;
                        init = /*%FSM<STATEINIT""">*/"[""Initialize""] call _TRACE;" \n
                         "" \n
                         "private _ranges = [_vehicle] call A3USPCM_fnc_utilGetVehicleEffectiveRanges;" \n
                         "private _initOK = false;" \n
                         "" \n
                         "if (crew _vehicle isEqualTo []) exitWith {[""vehicle is uncrewed""] call _TRACE};" \n
                         "if (isNil { _ranges get ""sensorsActive"" }) exitWith {[""vehicle has no radar""] call _TRACE};" \n
                         "if !(_ranges get ""sensorsActive"") exitWith {[""vehicle has no active sensors""] call _TRACE};" \n
                         "" \n
                         "_initOK = true;" \n
                         "" \n
                         "private _sensorsMax = _ranges get ""sensorsMax"";" \n
                         "private _sensorsMin = _ranges get ""sensorsMin"";" \n
                         "private _interestSweepTTL = 10;" \n
                         "private _interestPOITTL = 20;" \n
                         "" \n
                         "[""ranges=%1,canSweep=%2,canTarget=%3"", _ranges, _canSweep, _canTarget] call _TRACE;" \n
                         "" \n
                         "[[], 0] params[""_poiList"",""_poiScan"",""_poiCurrent"",""_poiIteration""];" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Bad_init">*/
                                class Bad_init
                                {
                                        itemno = 12;
                                        priority = 1.000000;
                                        to="Done";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!_initOK;" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "_">*/
                                class _
                                {
                                        itemno = 3;
                                        priority = 0.000000;
                                        to="Loop";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Loop">*/
                class Loop
                {
                        name = "Loop";
                        itemno = 4;
                        init = /*%FSM<STATEINIT""">*/"[""Loop: poiList=%1,poiScan=%2"", _poiList, _poiScan - diag_ticktime] call _TRACE;" \n
                         "" \n
                         "private _nextDelay = 2;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "__20__Dead_or_go">*/
                                class __20__Dead_or_go
