                /*%FSM<STATE "A_A_FC_Radar_Sca">*/
                class A_A_FC_Radar_Sca
                {
                        name = "A_A_FC_Radar_Sca";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"diag_log text format[""[A3USPCM] (aafc-fsm) Entry point; _this=%1"", _this];" \n
                         "" \n
                         "if !assert(params[" \n
                         "    [""_vehicle"", nil, [objNull]]" \n
                         "]) exitWith {};" \n
                         "" \n
                         "private _debug = param[1, false, [true]];" \n
                         "private[""_TRACE""];" \n
                         "" \n
                         "if !(_debug) then {" \n
                         "    _TRACE = {};" \n
                         "} else {" \n
                         "    _TRACE = {" \n
                         "        diag_log text format[""[A3USPCM] (aafc-fsm) [%1] %2"", _vehicle, format _this];" \n
                         "    };" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
