                                        itemno = 13;
                                        priority = 10.000000;
                                        to="POI_refresh";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"_canTarget &&" \n
                                         "{diag_tickTime > _poiScan} &&" \n
                                         "{ _poiList isEqualTo [] };" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
