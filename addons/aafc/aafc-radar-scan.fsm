                {
                        name = "Look_at_POI";
                        itemno = 18;
                        init = /*%FSM<STATEINIT""">*/"_poiCurrent params[""_poiTTL"",""_poiPosIn""];" \n
                         "" \n
                         "private[""_poiPos""];" \n
                         "" \n
                         "_poiIteration = _poiIteration + 1;" \n
                         "[""Look at POI: TTL=%1,Iter=%2,Pos=%3"", _poiTTL - diag_tickTime, _poiIteration, _poiPosIn] call _TRACE;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
