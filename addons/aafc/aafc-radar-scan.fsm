                         "private _initOK = false;" \n
                         "" \n
                         "if (crew _vehicle isEqualTo []) exitWith {[""vehicle is uncrewed""] call _TRACE};" \n
                         "if (isNil { _ranges get ""sensorsActive"" }) exitWith {[""vehicle has no radar""] call _TRACE};" \n
                         "if !(_ranges get ""sensorsActive"") exitWith {[""vehicle has no active sensors""] call _TRACE};" \n
                         "" \n
                         "_initOK = true;" \n
                         "" \n
                         "private _sensorsMax = _ranges get ""sensorsMax"";" \n
                         "private _sensorsMin = _ranges get ""sensorsMin"";" \n
                         "" \n
                         "[""ranges=%1"", _ranges] call _TRACE;" \n
