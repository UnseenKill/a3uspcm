                class Sweep_to_positio
                {
                        name = "Sweep_to_positio";
                        itemno = 22;
                        init = /*%FSM<STATEINIT""">*/"private _direction = [-deg(_vehicle animationSourcePhase ""mainturret"")] call A3USPCM_fnc_utilNormalizeDirection;" \n
                         "_direction = _direction + 91.5;" \n
                         "" \n
                         "_poiPos = _vehicle getPos[_sensorsMax, _direction] vectorAdd[0,0,500];" \n
