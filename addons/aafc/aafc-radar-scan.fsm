                /*%FSM<STATE "Translate_to_pos">*/
                class Translate_to_pos
                {
                        name = "Translate_to_pos";
                        itemno = 21;
                        init = /*%FSM<STATEINIT""">*/"_poiPos = markerPos _poiPosIn vectorAdd[0, 0, 500];" \n
                         "" \n
                         "private _offsets = [0, -20, 0, 20];" \n
                         "private _direction = (_vehicle getDir _poiPos) + (_offsets select(_poiIteration % 4));" \n
                         "" \n
                         "_poiPos = _vehicle getPos[_vehicle distance _poiPos, _direction];" \n
                         "" \n
                         "[""POI marker=%1,direction=%2,iteration=%3,offset=%4"", _poiPos, _direction, _poiIteration, _offsets select(_poiIteration % 4)] call _TRACE;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
